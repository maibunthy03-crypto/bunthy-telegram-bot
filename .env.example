# Required Telegram settings
BOT_TOKEN=replace_with_botfather_token
OWNER_ID=123456789

# Required web dashboard settings
ADMIN_USERNAME=bunthy
ADMIN_PASSWORD=change_this_to_a_long_password
JWT_SECRET=replace_with_at_least_32_random_characters
PUBLIC_URL=https://your-app.up.railway.app

# Railway provides PORT automatically
PORT=3000
DATABASE_PATH=/data/bunthy-bot.db

# Optional AI fallback. Leave blank to disable.
OPENAI_API_KEY=
OPENAI_MODEL=

# Translation performance
CACHE_TTL_SECONDS=3600
CACHE_MAX_ITEMS=1000
TRANSLATION_TIMEOUT_MS=12000
